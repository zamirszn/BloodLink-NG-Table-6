DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Africa/Lagos

# Leave DATABASE_URL empty to use the local db.sqlite3 SQLite database.
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Leave CACHE_URL empty in development to use local-memory cache.
CACHE_URL=
ALLOW_LOCMEM_CACHE=True
CELERY_BROKER_URL=redis://localhost:6379/0

# Security / proxy settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
TRUST_PROXY_SSL_HEADER=True
TRUSTED_PROXY_COUNT=0

# Phone verification
PHONE_VERIFICATION_GRACE_ENDS=
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# Notifications: use ConsoleBackend for local development.
NOTIFICATION_BACKEND=blood_requests.notifications.ConsoleBackend
NOTIFICATION_QUEUE=sync
NOTIFICATION_MAX_ATTEMPTS=5
SITE_BASE_URL=http://localhost:8000

# Termii (optional)
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd

# Africa's Talking (optional)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_BASE_URL=https://api.africastalking.com

SMS_WEBHOOK_SECRET=

# Request expiry / reminders
REQUEST_EXPIRY_DAYS_CRITICAL=3
REQUEST_EXPIRY_DAYS_URGENT=7
REQUEST_EXPIRY_DAYS_ROUTINE=14
REMINDER_CATCHUP_DAYS=7
MANAGE_TOKEN_LINK_ENABLED=True

# Logging / Sentry (optional)
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development
